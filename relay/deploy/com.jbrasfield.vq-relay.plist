<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jbrasfield.vq-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/vq-relay</string>
    <string>--listen</string>
    <string>127.0.0.1:8787</string>
    <string>--data-dir</string>
    <string>__HOME__/Library/Application Support/vq-relay</string>
    <string>--owner-token-file</string>
    <string>__HOME__/Library/Application Support/vq-relay/owner-token</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/vq-relay.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/vq-relay.log</string>
</dict>
</plist>
