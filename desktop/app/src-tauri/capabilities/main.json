{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: host events and the app's own commands only. Clipboard, dialog, opener and global-shortcut are used from Rust (shortcuts are registered only there), so the webview gets no plugin permissions.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-snapshot",
    "allow-forget-peer",
    "allow-ack-events",
    "allow-set-name",
    "allow-cancel-pairing",
    "allow-open-log-folder",
    "allow-pick-log-dir",
    "allow-copy-text",
    "allow-slots-snapshot",
    "allow-select-slot",
    "allow-unbind-slot",
    "allow-clear-all-slots",
    "allow-set-slot-settings",
    "allow-send-to-active",
    "allow-set-hotkey-modifiers",
    "allow-accessibility-status",
    "allow-open-accessibility-settings",
    "allow-diagnostics-info",
    "allow-open-diagnostics-file",
    "allow-open-diagnostics-folder"
  ]
}
